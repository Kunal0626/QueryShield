# Example connection settings for the QueryShield demo app.
#
# You normally do NOT edit this file by hand. Run:
#     bash victim/setup_db.sh
# which creates the database + user and writes victim/local.properties
# (gitignored) with a generated password.
#
# If you prefer to wire it up manually, copy this file to local.properties
# and fill in real values. local.properties is gitignored; this .example is not.
#
# allowPublicKeyRetrieval + sslMode=DISABLED keep a localhost connection to a
# MySQL 9.x server (caching_sha2_password) painless. Fine for a localhost demo;
# never do this against a real server.
db.url=jdbc:mysql://127.0.0.1:3306/queryshield?allowPublicKeyRetrieval=true&sslMode=DISABLED
db.user=qsdemo
db.password=CHANGE-ME
